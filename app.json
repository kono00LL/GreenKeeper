{
  "expo": {
    "name": "GreenKeeper",
    "slug": "GreenKeeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/greenkeeper-icon-108x108.png",
    "scheme": "greenkeeper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/greenkeeper-icon-108x108.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#20C978",
        "foregroundImage": "./assets/images/greenkeeper-icon-108x108.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.karcco.GreenKeeper",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/greenkeeper-icon-28x28.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "允许 GreenKeeper 使用相机拍摄植物照片。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 GreenKeeper 访问图库以选择植物照片。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#20C978",
          "image": "./assets/images/greenkeeper-icon-108x108.png",
          "imageWidth": 76
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a"]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#00866c",
          "defaultChannel": "plant-care"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db2e78a0-9239-48d4-a410-4c97b335a477"
      }
    }
  }
}
